# Copy to backend/.env and fill in. Everything blank still runs: without an LLM key FINN uses its
# rule-based parsers and templates; without VAPID keys alerts go to the in-app inbox only.

DATABASE_URL=sqlite:///./finn.db          # production: postgresql://user:pass@host/db (Neon / Supabase)
FRONTEND_ORIGIN=http://localhost:3000     # comma-separated; *.vercel.app is always allowed
JOB_TOKEN=                                # long random string; protects POST /api/jobs/*

LLM_PROVIDER=gemini                       # gemini | groq | openai | anthropic | none
LLM_API_KEY=
LLM_FAST_MODEL=                           # blank = provider default in app/config.py (VERIFY current names)
LLM_SMART_MODEL=
LLM_DAILY_BUDGET_USD=0.50

WEBSEARCH_PROVIDER=none                   # none | tavily | brave  (bios for management changes)
WEBSEARCH_API_KEY=

VAPID_PUBLIC_KEY=                         # web push; generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# DATA_DIR=./data                        # PDF download cache (safe to lose); default backend/data
REPLAY_DEFAULT=false
TZ=Asia/Kolkata
